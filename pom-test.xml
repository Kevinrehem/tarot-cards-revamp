<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tarotcardsrevamp</groupId>
    <artifactId>tarotcardsrevamp-test-runner</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <excludes>
                        <exclude>com/tarotcardsrevamp/TarotCardsRevampMod.java</exclude>
                        <exclude>com/tarotcardsrevamp/config/**</exclude>
                        <exclude>com/tarotcardsrevamp/core/**</exclude>
                        <exclude>com/tarotcardsrevamp/deck/TarotDeckMenu.java</exclude>
                        <exclude>com/tarotcardsrevamp/deck/TarotDeckScreen.java</exclude>
                        <exclude>com/tarotcardsrevamp/deck/TarotDeckItem.java</exclude>
                        <exclude>com/tarotcardsrevamp/card/TarotCardItem.java</exclude>
                        <exclude>com/tarotcardsrevamp/card/UnidentifiedTarotCardItem.java</exclude>
                        <exclude>com/tarotcardsrevamp/effect/TarotEffectHandler.java</exclude>
                        <exclude>com/tarotcardsrevamp/effect/TarotQuestHandler.java</exclude>
                        <exclude>com/tarotcardsrevamp/loot/TarotLootModifier.java</exclude>
                        <exclude>com/tarotcardsrevamp/command/TarotCommand.java</exclude>
                        <exclude>com/tarotcardsrevamp/compat/CuriosCompat.java</exclude>
                        <exclude>com/tarotcardsrevamp/network/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
